# 复制为 .env 后按需修改

# ---- 数据库 ----
DB_ROOT_PASSWORD=hahatool_root
DB_NAME=hahatool
DB_USER=hahatool
DB_PASSWORD=hahatool_pass

# ---- 端口 ----
# WordPress 后台： http://localhost:8090/wp-admin/
WP_PORT=8090
# Next.js 前台： http://localhost:3000
FRONTEND_PORT=3000

# ---- 站点 ----
SITE_NAME=HahaTool

# ---- WordPress 管理员（scripts/setup-wp.sh 安装时使用）----
WP_ADMIN_USER=admin
WP_ADMIN_PASS=hahatool_admin
WP_ADMIN_MAIL=admin@hahatool.local
