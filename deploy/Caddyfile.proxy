# 生产：hahatool-frontend(caddy) 监听 :3000。Cloudflare Tunnel → 本代理。
# /media/* → MinIO 公共桶（对象存储）；其余 → WordPress。静态资源长缓存 + 压缩。
:3000 {
	encode zstd gzip

	# 安全响应头（仅作用于 tool.hahaha.chat，不影响同 zone 其他应用）。
	# HSTS 配合 WP 层 http→https 跳转：回访浏览器直接走 https，免去 301 往返。
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# 对象存储：/media/<bucket>/<obj> → MinIO（manyan-minio，公共读桶 hahatool-media）
	# 仅对成功响应加长缓存，避免 404/错误被 CDN 当作 immutable 缓存
	handle_path /media/* {
		reverse_proxy manyan-minio-1:9000 {
			@ok status 200 206
			handle_response @ok {
				header Cache-Control "public, max-age=31536000, immutable"
				copy_response
			}
		}
	}

	# 其余请求 → WordPress；静态资源加长缓存
	handle {
		@static path *.css *.js *.mjs *.woff2 *.woff *.ttf *.otf *.png *.jpg *.jpeg *.webp *.avif *.gif *.svg *.ico
		header @static Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy hahatool-wordpress:80 {
			header_up X-Forwarded-Proto https
		}
	}
}
